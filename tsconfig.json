{
    "compilerOptions": {
        "module": "node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha"
        ],
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "useDefineForClassFields": false,
        "sourceMap": true,
        "rootDir": "src"
    },
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
